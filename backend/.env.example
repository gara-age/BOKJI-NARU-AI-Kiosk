ADMIN_PASSWORD=change-this-for-local-demo
DATABASE_PATH=./data/navi.sqlite3
SUMMARY_TTL_MINUTES=30
OLLAMA_BASE_URL=http://192.168.0.10:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_ENABLED=false
PUBLIC_DATA_API_KEY=
# auto: API key exists when the public-data provider is used, otherwise safe seed data.
# seed: always use reviewed seed data. Use a decoded service key from data.go.kr.
PUBLIC_DATA_MODE=auto
PUBLIC_DATA_TIMEOUT_SECONDS=5
PUBLIC_DATA_CACHE_MINUTES=360
PUBLIC_DATA_MAX_PAGES=20
# Optional pilot-area filter for the local-government welfare API, for example 서울특별시 / 성동구.
PUBLIC_DATA_LOCAL_SIDO=
PUBLIC_DATA_LOCAL_SIGUNGU=
MUSETALK_API_URL=http://127.0.0.1:8001
NAVI_API_PUBLIC_URL=http://127.0.0.1:8000
TTS_PROVIDER=auto
TTS_EDGE_VOICE_KO=ko-KR-SunHiNeural
TTS_MELO_DEVICE=cpu
TTS_MELO_SPEAKER_KO=KR
TTS_MELO_SPEED=1.0
# Optional dedicated MeloTTS adapter, e.g. http://127.0.0.1:8002/synthesize
TTS_MELO_API_URL=
STT_MODEL=medium
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL_PATH=./models/naruya.onnx
WAKE_WORD_THRESHOLD=0.5
# Ignore silence and low-level microphone noise before wake-word inference.
WAKE_WORD_MIN_RMS=0.008
